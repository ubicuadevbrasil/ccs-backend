# ===========================================
# CCS Backend Environment Configuration
# ===========================================

# Application Configuration
NODE_ENV=development
PORT=8082
APPLICATION_URL=https://vm103-8082.ubicuacloud.com.br

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ccs_db
DATABASE_USER=ccs_user
DATABASE_PASSWORD=ccs_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CDN Configuration
CDN_URL=https://cdn.ubicuacloud.com

# ===========================================
# WhatsApp Provider Configuration
# ===========================================

# Feature Flags - Toggle WhatsApp providers
# Set to true to enable, false to disable
EVOLUTION_WHATSAPP=false
VONAGE_WHATSAPP=true

# ===========================================
# Evolution API Configuration
# (Only required if EVOLUTION_WHATSAPP=true)
# ===========================================
EVOLUTION_API_BASE_URL=https://evolution.ubicuacloud.com.br
EVOLUTION_API_KEY=evapi_your-evolution-api-key-here
EVOLUTION_API_INSTANCE=

# Evolution RabbitMQ Configuration
EVOLUTION_RABBITMQ_URI=

# ===========================================
# Vonage API Configuration
# (Only required if VONAGE_WHATSAPP=true)
# ===========================================

# Vonage Production Configuration
VONAGE_MOBILE=5511969009126@c.us
VONAGE_URL=https://ccs.sanofi-mobile.com.br/vonage/send-message
VONAGE_MESSAGE_URL=https://api.nexmo.com/v0.1/messages
VONAGE_USER=your-vonage-user-id
VONAGE_PASSWORD=your-vonage-password

# Vonage Sandbox Configuration
SANDBOX_MOBILE=14157386102@c.us
SANDBOX_URL=https://vm103-8082.ubicuacloud.com.br/vonage/send-message
SANDBOX_MESSAGE_URL=https://messages-sandbox.nexmo.com/v0.1/messages
SANDBOX_USER=your-sandbox-user-id
SANDBOX_PASSWORD=your-sandbox-password

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN=*
CORS_CREDENTIALS=false
